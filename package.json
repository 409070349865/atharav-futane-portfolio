  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "generate:context": "node scripts/generate-portfolio-context.mjs",
    "predev": "npm run generate:context",
    "dev": "concurrently -k \"node --watch server/index.js\" \"vite\"",
